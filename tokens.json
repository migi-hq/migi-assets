{
  "color": {
    "brand": {
      "$value": "#FAD6DC",
      "$type": "color",
      "$description": "蜜桃粉：主品牌色、按鈕、卡片"
    },
    "milktea": {
      "$value": "#EFE3DA",
      "$type": "color",
      "$description": "奶茶色：主品牌色（與蜜桃粉並列）、溫潤中性、餐飲/活動/稀有"
    },
    "milktea-bd": {
      "$value": "#DECDBC",
      "$type": "color",
      "$description": "奶茶深框：固定牌局卡外框（C-2）、滿桌狀態牌文字"
    },
    "milktea-light": {
      "$value": "#FAF5EF",
      "$type": "color",
      "$description": "奶茶淺底：固定牌局卡卡面"
    },
    "milktea-ink": {
      "$value": "#7A5C42",
      "$type": "color",
      "$description": "奶茶棕字：固定牌局卡文字、滿桌狀態牌文字"
    },
    "brand-tint": {
      "$value": "#FFECF1",
      "$type": "color",
      "$description": "極淡粉：選中態底色（比 --brand-light 更淡，不搶前景）。🔴 2026-09-09 從 #FFF6F8 加深一階（使用者指定，起因是會員等級卡的粉底太淡）。⚠ 改在這裡而不是改那一張卡：這個底色 ＋ 1px --brand 外框是硬規則 13.8 那個組合，migi-web 有 4 處（NavRow／配桌進度卡／配桌彈窗／會員等級卡）＋ migi-admin 1 處 —— 只改一張就是 13.8 禁止的「第三種粉」。🔴 刻意**不**調到 --brand-light 的 #FFE7EE：那會讓兩個 token 同色，而且推翻 2026-09-03「底是 tint 不是 light」的決定（見 migi-web/src/lib/ui.jsx 的 NavRow 註解）"
    },
    "brand-light": {
      "$value": "#FFE7EE",
      "$type": "color",
      "$description": "淺粉：Hero 卡、提示欄底"
    },
    "ink": {
      "$value": "#2E2B2C",
      "$type": "color",
      "$description": "深墨：主文字、黑底按鈕"
    },
    "accent": {
      "$value": "#C2607A",
      "$type": "color",
      "$description": "桃紅：強調文字、連結、讚 icon"
    },
    "gold": {
      "$value": "#E8B89B",
      "$type": "color",
      "$description": "金棕：稱號邊框、點綴"
    },
    "gray-1": {
      "$value": "#5C5754",
      "$type": "color",
      "$description": "次要文字。🔴 2026-09-09 從 #7A7572 加深一階（使用者指定）—— 起因是「本季段位分」與「依積分、時間幫妳湊一桌」這類小字太淡讀不清。⚠ 那些小字**沒有共用元件**，各自 inline 寫 var(--gray-1)（光 migi-web 就 187 處）⇒ 共用的是這個 token，所以改在這裡而不是改那兩處。📌 加深後仍照原本的階梯節奏：hint #B4AEA9 → gray-2 #9A9491 → gray-1 #5C5754，每階差約 26–32。⚠ 不要再往下調 —— 更深就接近 --ink #2E2B2C，「主要文字」與「次要文字」的差別會消失，而整個版面的分層是靠那個差別"
    },
    "gray-2": {
      "$value": "#9A9491",
      "$type": "color",
      "$description": "提示文字"
    },
    "hint": {
      "$value": "#B4AEA9",
      "$type": "color",
      "$description": "弱提示文字（第三層）：2026-08-15 三端統一命名時收進 token，web 目前未使用"
    },
    "gray-3": {
      "$value": "#ECEAE9",
      "$type": "color",
      "$description": "邊框"
    },
    "gray-4": {
      "$value": "#F2F0EE",
      "$type": "color",
      "$description": "淺灰底：次要按鈕、chip、頭像圈。⚠ 2026-09-06 起「分隔線」不再用它，改用 --divider"
    },
    "divider": {
      "$value": "#DED9D5",
      "$type": "color",
      "$description": "分隔線專用。🔴 2026-09-06 從 gray-4 拆出來：gray-4 同時是 41 處的底色與 39 處的線，調深線就會把 chip 與頭像圈一起調深 —— 一個名字兩個意思。只用在 borderTop／borderBottom，不要拿它當底色或整框"
    },
    "white": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "外殼／卡片底"
    },
    "field-bg": {
      "$value": "#F8F7F6",
      "$type": "color",
      "$description": "輸入框、次要卡片底"
    },
    "field-bd": {
      "$value": "#ECE7E4",
      "$type": "color",
      "$description": "輸入框邊框"
    },
    "page-bg": {
      "$value": "#F6F5F4",
      "$type": "color",
      "$description": "整頁底：後台主體用；web 的殼是白底故未使用"
    },
    "danger": {
      "$value": "#B23B3B",
      "$type": "color",
      "$description": "錯誤／警示紅"
    },
    "line-green": {
      "$value": "#06C755",
      "$type": "color",
      "$description": "🔴 LINE 官方品牌色，不是我們的設計決定 —— 不可調整。用在「這件事跟 LINE 有關」：登入按鈕、同步角標。POS 的 LINE 登入按鈕也是這個值（待辦 20），所以它跨端"
    },
    "tile-face": {
      "$value": "#FFFDF9",
      "$type": "color",
      "$description": "牌面底（象牙白）"
    },
    "tile-face-bd": {
      "$value": "#E5DCCF",
      "$type": "color",
      "$description": "牌面邊框"
    },
    "tile-face-lip": {
      "$value": "#E0D6C6",
      "$type": "color",
      "$description": "牌面下緣立體感"
    },
    "ok": {
      "$value": "#63B58C",
      "$type": "color",
      "$description": "可用綠。⚠ 目前唯一的用途是 POS 桌況「空桌」那顆狀態圓點 —— 「可以用／不能用」是店員的問題，客人端沒有這個概念。之後若有第二處要用綠，先確認講的是不是同一件事"
    }
  },
